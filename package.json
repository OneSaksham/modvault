{
  "name": "modvault",
  "version": "1.0.0",
  "description": "ModVault — High-Performance Minecraft Mod Engine & FPS Optimizer with Universal Launcher Detection",
  "main": "dist-electron/main.js",
  "author": "Saksham (https://github.com/saksham-kumar1621)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/saksham-kumar1621/Minecraft-Mod-Installer.git"
  },
  "bugs": {
    "url": "https://github.com/saksham-kumar1621/Minecraft-Mod-Installer/issues"
  },
  "homepage": "https://github.com/saksham-kumar1621/Minecraft-Mod-Installer#readme",
  "keywords": [
    "minecraft",
    "mod-installer",
    "tlauncher",
    "tl-legacy",
    "modrinth",
    "sodium",
    "iris-shaders",
    "fps-booster",
    "electron",
    "vite",
    "react"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:win": "npm run build && electron-builder --win --x64",
    "start": "electron .",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.modvault.client",
    "productName": "ModVault",
    "copyright": "Copyright (c) 2026 Saksham",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "public/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ModVault"
    }
  },
  "dependencies": {
    "framer-motion": "^12.4.7",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.2.0",
    "electron-builder": "^26.18.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
